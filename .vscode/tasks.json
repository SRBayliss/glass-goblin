{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Jekyll: Serve",
            "detail": "Local dev server with live reload at http://127.0.0.1:4000/",
            "type": "shell",
            "command": "bundle exec jekyll serve --livereload",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "isBackground": true,
            "problemMatcher": {
                "owner": "jekyll",
                "pattern": {
                    "regexp": "^\\s+(Jekyll )?Error:\\s+(.*)$",
                    "file": 1,
                    "message": 2
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^\\s*Generating\\.\\.\\.",
                    "endsPattern": "Server running\\.\\.\\."
                }
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            }
        },
        {
            "label": "Jekyll: Serve (with drafts)",
            "detail": "Local dev server including draft posts",
            "type": "shell",
            "command": "bundle exec jekyll serve --livereload --drafts",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "isBackground": true,
            "problemMatcher": {
                "owner": "jekyll",
                "pattern": {
                    "regexp": "^\\s+(Jekyll )?Error:\\s+(.*)$",
                    "file": 1,
                    "message": 2
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^\\s*Generating\\.\\.\\.",
                    "endsPattern": "Server running\\.\\.\\."
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            }
        },
        {
            "label": "Jekyll: Build",
            "detail": "One-shot production-equivalent build into _site",
            "type": "shell",
            "command": "bundle exec jekyll build",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            }
        },
        {
            "label": "Bundle: Install",
            "detail": "Install gems into ./vendor (run once after cloning or changing the Gemfile)",
            "type": "shell",
            "command": "bundle install",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        }
    ]
}
